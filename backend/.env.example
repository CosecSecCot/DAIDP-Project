# Application
APP_ENV=development
ADMIN_API_KEY=replace-with-a-random-admin-key
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=20000000
MAX_FOLLOWUP_ROUNDS=2

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# PostgreSQL
POSTGRES_DB=mediqare_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/mediqare_db
